# Fill in ONE of the two keys below. Whichever is non-empty decides which
# LLM provider the app calls. If both are filled, GEMINI is used unless you
# force a provider with LLM_PROVIDER below.

GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider instead of auto-detecting from the keys above.
# Values: gemini | openai
LLM_PROVIDER=

# Optional: override the default models used for each provider.
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini

# Optional: path to a different source document (defaults to data/HR_Leave_Policy_and_Encashment_Guidelines.docx)
DOCUMENT_PATH=

# Used by the Streamlit UI to reach the FastAPI backend.
API_BASE_URL=http://localhost:8000
